DATABASE_URL=postgres://user:pass@host/db
# Your LLM key env var is whatever triage.config.json's llm.apiKeyEnv names (set by the interview):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# The shared mailbox this deployment triages (also set by `triage init`):
GMAIL_USER=office@yourdomain.example
# Gmail auth — primary: OAuth granted directly by the mailbox (npm run triage -- init handles this)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Gmail auth — alternative: service account with domain-wide delegation (unused by default)
# GOOGLE_SA_EMAIL=triage-bot@<gcp-project>.iam.gserviceaccount.com
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
CRON_SECRET=
